{
  "manifest_version": 2,
  "id": "github.hhhhhhezeus.maijam",
  "version": "0.1.2",
  "name": "MaiJam 群聊协作乐队",
  "description": "通过规则聚合群聊互动，本地生成原创分轨音乐；不调用 LLM，支持 WAV 与 MIDI 导出。",
  "author": {"name": "hhhhhhezeus", "url": "https://github.com/hhhhhhezeus"},
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/hhhhhhezeus/MaiJam",
    "homepage": "https://github.com/hhhhhhezeus/MaiJam",
    "documentation": "https://github.com/hhhhhhezeus/MaiJam/blob/main/README.md",
    "issues": "https://github.com/hhhhhhezeus/MaiJam/issues"
  },
  "plugin_type": "media",
  "host_application": {"min_version": "1.3.16", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.20.0", "max_version": "2.20.99"},
  "dependencies": [],
  "capabilities": ["send.text"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
